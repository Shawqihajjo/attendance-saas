.git
.github
.idea
.vscode
.DS_Store
*.md
!README.md

# Secrets and local env (never bake into images)
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.*
# Do not send .env.test into image build context (CI copies it only on the runner for PHPUnit).

# TLS material
docker/nginx/certs
**/*.pem
**/*.key

# Dependencies and build output (images install their own)
backend/vendor
backend/var
frontend/node_modules
frontend/dist

# Runtime media and employee photographs (never bake into layers)
**/var/photos
**/uploads

# Caches and dumps
**/.phpunit.cache
**/*.sql
**/*.sql.gz
**/*.dump
**/backups

# IDE
**/*.iml
