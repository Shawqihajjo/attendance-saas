FROM composer:2 AS vendor

WORKDIR /app

COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --no-progress --ignore-platform-req=ext-amqp --ignore-platform-req=ext-redis

COPY backend/ ./
RUN rm -rf tests .phpunit.cache \
    && rm -f .env .env.dev .env.test .env.local .env.local.php phpunit.dist.xml phpstan.neon \
    && composer dump-autoload --no-dev --classmap-authoritative --no-interaction

FROM php:8.4-fpm-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libicu-dev \
        libzip-dev \
        librabbitmq-dev \
    && docker-php-ext-install -j"$(nproc)" intl opcache pdo_mysql zip \
    && pecl install redis amqp \
    && docker-php-ext-enable redis amqp \
    && rm -rf /var/lib/apt/lists/*

COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/zz-attendance.ini
COPY docker/php/www.conf /usr/local/etc/php-fpm.d/zz-attendance.conf
COPY docker/php/entrypoint.prod.sh /usr/local/bin/attendance-entrypoint
COPY docker/php/worker.sh /usr/local/bin/attendance-worker
RUN chmod +x /usr/local/bin/attendance-entrypoint /usr/local/bin/attendance-worker

COPY --from=vendor /app /var/www/html
RUN mkdir -p /var/www/html/var/cache /var/www/html/var/log /var/www/html/var/share /var/www/html/var/photos \
    && chown -R www-data:www-data /var/www/html/var \
    && php-fpm -t

WORKDIR /var/www/html

ENTRYPOINT ["attendance-entrypoint"]
CMD ["php-fpm"]
