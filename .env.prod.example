# Staging and production. Copy to .env.prod (or .env.staging) and fill every value from the secret store.
# Do not commit .env.prod or .env.staging. Do not reuse values from .env.example.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
TRUSTED_PROXIES=REMOTE_ADDR
DEFAULT_URI=https://attendance.example
PLATFORM_HOSTNAME=attendance.example
LOG_LEVEL=error

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=platform
MYSQL_USER=
MYSQL_PASSWORD=

REDIS_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

# 32 bytes, base64. Key id must not be "dev" or "test".
TENANT_DB_CREDENTIALS_KEY=
TENANT_DB_CREDENTIALS_KEY_ID=
TENANT_DATABASE_DRIVER=mysql
TENANT_DATABASE_HOST=mysql
TENANT_DATABASE_PORT=3306
TENANT_DATABASE_USER_HOST=%
TENANT_DATABASE_SERVER_VERSION=8.4

# Private photograph volume path inside the PHP container.
MEDIA_LOCAL_DIRECTORY=/var/www/html/var/photos

# Leave empty until separate SELECT-only explorer accounts exist.
# Never copy the application database user or password here.
EXPLORER_PLATFORM_DATABASE_URL=
EXPLORER_TENANT_DATABASE_URL=

TLS_TERMINATION=nginx
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./docker/nginx/certs

MESSENGER_TIME_LIMIT=3600
MESSENGER_MEMORY_LIMIT=128M
MESSENGER_MESSAGE_LIMIT=500
