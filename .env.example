# Local development only. Copy to .env before: docker compose up --build
# Do not use these values in staging or production.
# Production refuses the local APP_SECRET and TENANT_DB_CREDENTIALS_KEY patterns documented in docs/deployment.md.

# Symfony / Compose
APP_SECRET=dev-only-change-me
PLATFORM_HOSTNAME=localhost

# MySQL (platform database and Compose root/admin)
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=platform
MYSQL_USER=attendance
MYSQL_PASSWORD=attendance

# RabbitMQ
RABBITMQ_USER=attendance
RABBITMQ_PASSWORD=attendance

# Encrypts tenant database passwords stored in the platform registry.
# Local example only (32 bytes, base64). Generate a new key for any shared environment:
#   openssl rand -base64 32
TENANT_DB_CREDENTIALS_KEY=bG9jYWwtZGV2LXRlbmFudC1kYi1rZXktMzJieXRlcyE=
TENANT_DB_CREDENTIALS_KEY_ID=dev

# Optional: read-only Database Explorer accounts (leave empty until created).
# Do not copy the application MySQL user or password into these URLs.
# EXPLORER_PLATFORM_DATABASE_URL=
# EXPLORER_TENANT_DATABASE_URL=

# Compose builds PLATFORM_DATABASE_URL, TENANT_DATABASE_URL, REDIS_URL, and
# MESSENGER_TRANSPORT_DSN for the php and messenger services from the variables above.
# Staging and production use .env.prod from .env.prod.example (never commit that file).
